{
  "rewrites": [
    { "source": "/", "destination": "/hosting/index.html" },
    { "source": "/robots.txt", "destination": "/hosting/robots.txt" },
    { "source": "/logo/:file", "destination": "/hosting/logo/:file" }
  ],
  "headers": [
    { "source": "/logo/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
