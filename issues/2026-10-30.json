  "stories": [
    {
      "topic": "Markets",
      "relevance": "Market-wide",
      "headline": "India's 10-year bond yield fell 5 basis points, its largest one-day drop in three months",
      "what": "The benchmark 6.94% 2036 government bond closed at a yield of 7.39% on 29 October, down from 7.44%. Reuters cited lower US Treasury yields after the Fed meeting, softer oil prices and buying after the yield failed to rise above 7.50%, ahead of a ₹33,000 crore government bond sale on Friday.",
      "why": "Bond prices move opposite to yields, so a fall in yields raises the value of bonds already held, including those in debt funds, and longer-dated bonds move more. Yields also feed into borrowing costs across the economy.",
      "source": {
        "name": "Reuters",
        "url": "https://indianopinion.org/india-10-year-bond-yield-falls-as-treasuries-oil-ease/"
      },
      "also": {
        "name": "Kotak Neo (CCIL data)",
        "url": "https://www.kotakneo.com/news/market-news/india-10-year-g-sec-yield-falls-to-7-39-on-fed-signals/"
      }
    },
    {
      "topic": "Global",
      "relevance": "Market-wide",
      "headline": "US growth ran at a 3.4% annual rate in July to September, and September PCE inflation was 3.6%",
      "what": "The US Bureau of Economic Analysis's advance estimate put real GDP growth at a 3.4% annual rate in July to September, after 2.2% in April to June. In September, the PCE price index rose 3.6% on the year and core PCE 3.1%. The data came a day after the Federal Reserve held its target range at 3.75% to 4.00%, with two members preferring an increase.",
      "why": "US growth and inflation shape expectations for Federal Reserve policy, which moves Treasury yields and the dollar. Those feed into foreign portfolio flows into Indian shares and bonds, and into the rupee.",
      "source": {
        "name": "BEA (GDP)",
        "url": "https://www.bea.gov/news/2026/gdp-advance-estimate-3rd-quarter-2026"
      },
      "also": {
        "name": "BEA (PCE)",
        "url": "https://www.bea.gov/news/2026/personal-income-and-outlays-september-2026"
      }
    },
    {
      "topic": "Corporate",
      "relevance": "Sector",
      "headline": "Coal India's July to September profit rose 57% to ₹6,547 crore",
      "what": "Coal India reported consolidated net profit of ₹6,547.43 crore for July to September 2026, up from ₹4,167.14 crore a year earlier, as revenue from operations rose 21% to ₹44,178.74 crore. Production rose 4% to 151.37 million tonnes, and the board declared an interim dividend of ₹10.25 a share.",
      "why": "Coal output and dispatches track the fuel supply for thermal power plants, and the price Coal India realises feeds into costs for power producers and other coal users.",
      "source": {
        "name": "ANI via The Tribune",
        "url": "https://www.tribuneindia.com/news/business/coal-indias-q2-net-profit-rises-57-to-rs-6547-crore-announces-rs-10-25-dividend"
      },
