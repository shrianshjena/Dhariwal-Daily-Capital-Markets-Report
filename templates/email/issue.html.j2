{#- Kubeerra Market Brief: email edition, rendered twice.
    variant "gmail": navy masthead and footer, for Gmail (paste or the morning draft).
    variant "outlook": light masthead and footer, so the text stays readable even when Outlook
    drops text colours on paste; also carries the Outlook (Word engine) conditionals.
    Both: left-aligned 640px column, table layout, inline styles, system fonts. The issue is
    grouped into numbered clusters with a contents list (D-046); in-page links (#...) only jump
    within the email. Other links go only to kubeerra.com pages and the firm's email address;
    outside sources are named, never linked. -#}
{%- set C = tokens.color -%}
{%- set G = tokens.layout.emailGutter -%}
{%- set W = tokens.layout.emailWidth -%}
{%- set OL = variant == "outlook" -%}
{#- Gmail inherits the font from the column, which keeps its file small; Outlook's Word engine
    needs the font on every element. -#}
{%- set FONT = ("font-family:" ~ tokens.font.email.sans ~ ";")|safe -%}
{%- set SANS = (FONT if OL else "")|safe -%}
{%- set MONO = ("font-family:" ~ (tokens.font.email.mono if OL else tokens.font.email.monoCompact) ~ ";")|safe -%}
{%- set LH = ("mso-line-height-rule:exactly;" if OL else "")|safe -%}
{%- set RP = (' role="presentation"' if OL else '')|safe -%}
{%- set PC = (("color:" ~ tokens.color.text.primary ~ ";") if OL else "")|safe -%}
{#- Gmail: the column already sets left alignment, and padding uses the three-value form. -#}
{%- set TL = ("text-align:left;" if OL else "")|safe -%}
{%- set GP = ((" " ~ G ~ "px") if OL else "")|safe -%}
{%- if OL -%}
{%- set T = {"mast_bg": C.surface.paper, "mast_title": C.brand.navy, "mast_soft": C.text.secondary,
             "foot_bg": C.surface.soft, "foot_title": C.brand.navy, "foot_text": C.text.primary,
             "foot_soft": C.text.secondary, "foot_link": C.brand.cobalt} -%}
{%- else -%}
{%- set T = {"mast_bg": C.brand.navy, "mast_title": C.text.inverse, "mast_soft": C.text.inverseSoft,
             "foot_bg": C.brand.navy, "foot_title": C.text.inverse, "foot_text": C.text.inverse,
             "foot_soft": C.text.inverseSoft, "foot_link": C.text.inverseLink} -%}
{%- endif -%}
{%- set meta = issue.meta -%}
{%- set B = "border-bottom:1px solid " ~ C.border.default ~ ";" -%}
{%- macro rule(width, color, height=2) -%}
{%- if OL -%}<table{{ RP }} cellpadding="0" cellspacing="0" border="0"><tr><td width="{{ width }}" height="{{ height }}" bgcolor="{{ color }}" style="width:{{ width }}px;height:{{ height }}px;background-color:{{ color }};font-size:0;line-height:0;">&nbsp;</td></tr></table>
{%- else -%}<div style="width:{{ width }}px;height:{{ height }}px;background-color:{{ color }};"></div>{%- endif -%}
{%- endmacro -%}
{%- macro bandrow(color) -%}
<tr><td height="6" bgcolor="{{ color }}" style="height:6px;background-color:{{ color }};font-size:0;line-height:0;">&nbsp;</td></tr>
{%- endmacro -%}
{%- macro mtop(top) -%}{{ "margin:0;" if top == 0 else "margin:" ~ top ~ "px 0 0;" }}{%- endmacro -%}
{%- macro label(text, color, top=0) -%}
<p style="{{ mtop(top) }}{{ MONO }}font-size:11px;{% if OL %}line-height:16px;{% endif %}letter-spacing:1.2px;color:{{ color }};{{ LH }}">{{ text|upper }}</p>
{%- endmacro -%}
{%- macro para(text, top=12, size=16, color=None, weight=400) -%}
<p style="{{ mtop(top) }}{{ SANS }}font-size:{{ size }}px;line-height:{{ (size * 1.5)|round|int }}px;{% if weight != 400 %}font-weight:{{ weight }};{% endif %}{% if color %}color:{{ color }};{% else %}{{ PC }}{% endif %}{{ LH }}">{{ text|t }}</p>
{%- endmacro -%}
{%- macro names(items) -%}{{ items|map(attribute="name")|unique|join(", ") }}{%- endmacro -%}
{%- macro srcline(items, top=8, prefix=None) -%}
<p style="{{ mtop(top) }}{{ SANS }}font-size:13px;line-height:19px;color:{{ C.text.secondary }};{{ LH }}">{{ (prefix or ("Sources" if items|length > 1 else "Source"))|t }}: {{ names(items) }}</p>
{%- endmacro -%}
{%- macro klink(link, color=None) -%}<a href="{{ link.url }}" style="color:{{ color or C.brand.cobalt }};text-decoration:underline;">{{ link.name }}</a>{%- endmacro -%}
{%- macro th(text, align="left") -%}
{%- if OL -%}<th align="{{ align }}" style="padding:0 0 8px;{{ B }}{{ MONO }}font-size:11px;line-height:16px;letter-spacing:1px;font-weight:400;color:{{ C.text.secondary }};{{ LH }}">{{ text|upper }}</th>
{%- else -%}<th align="{{ align }}" style="padding:0 0 8px;{{ B }}font-weight:400;">{{ text|upper }}</th>{%- endif -%}
{%- endmacro -%}
{%- macro thr() -%}<tr{% if not OL %} style="{{ MONO }}font-size:11px;line-height:16px;letter-spacing:1px;color:{{ C.text.secondary }};"{% endif %}>{%- endmacro -%}
{%- macro bar(pct, color) -%}
{%- if OL -%}<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td width="{{ pct }}%" height="10" bgcolor="{{ color }}" style="width:{{ pct }}%;height:10px;background-color:{{ color }};font-size:0;line-height:0;">&nbsp;</td>{% if pct < 100 %}<td width="{{ 100 - pct }}%" height="10" style="width:{{ 100 - pct }}%;height:10px;font-size:0;line-height:0;">&nbsp;</td>{% endif %}</tr></table>
{%- else -%}<div style="width:{{ pct }}%;height:10px;background-color:{{ color }};"></div>{%- endif -%}
{%- endmacro -%}
{%- macro chg(v, neutral=False, size=14) -%}<span style="font-size:{{ size }}px;font-weight:700;color:{{ v|dircolor(neutral) }};white-space:nowrap;">{{ v|arrow }}&nbsp;{{ v|pct }}</span>{%- endmacro -%}
{%- macro schemerow(name, detail, value, value_color=None) -%}
<tr>
<td valign="top" style="padding:10px 8px 10px 0;{{ B }}{{ SANS }}font-size:15px;line-height:21px;font-weight:600;{{ PC }}{{ LH }}">{{ name|t }}<br><span style="font-size:13px;{% if OL %}line-height:19px;{% endif %}font-weight:400;color:{{ C.text.secondary }};">{{ detail|t }}</span></td>
<td align="right" valign="top" style="padding:10px 0 10px 8px;{{ B }}{{ SANS }}font-size:15px;line-height:21px;font-weight:700;{% if value_color %}color:{{ value_color }};{% else %}{{ PC }}{% endif %}white-space:nowrap;{{ LH }}">{{ value|safe }}</td>
</tr>
{%- endmacro -%}
{%- macro item(title, text, srcs, top=12) -%}
<p style="{{ mtop(top) }}{{ SANS }}font-size:15px;line-height:23px;{{ PC }}{{ LH }}">{% if title %}<b>{{ title|t }}.</b> {% endif %}{{ text|t }} <span style="font-size:13px;{% if OL %}line-height:19px;{% endif %}color:{{ C.text.secondary }};">{{ names(srcs) }}</span></p>
{%- endmacro -%}
{%- macro sec(sid, headline) -%}
{%- set s = S[sid] -%}
<tr><td class="gut"{% if OL %} align="left"{% endif %} style="{{ TL }}padding:36px {{ G }}px 0{{ GP }};">{% if OL %}<a name="s-{{ sid }}" id="s-{{ sid }}"></a>{% endif %}
{{ rule(24, C.brand.cobalt) }}
{{ label(s.num ~ " · " ~ s.title, C.brand.cobalt, 10) }}
{% if headline %}<h3 style="margin:6px 0 0;{{ SANS }}font-size:20px;line-height:27px;font-weight:700;{{ PC }}{{ LH }}">{{ headline|t }}</h3>{% endif %}
</td></tr>
{%- endmacro -%}
{%- macro band(cid) -%}
{%- set cl = (clusters|selectattr("id", "equalto", cid)|list)[0] -%}
<tr><td style="padding:44px 0 0 0;font-size:0;line-height:0;">&nbsp;</td></tr>
<tr><td class="gut" align="left" bgcolor="{{ C.surface.soft }}" style="{{ TL }}padding:18px {{ G }}px 16px{{ GP }};background-color:{{ C.surface.soft }};border-left:4px solid {{ C.brand.cobalt }};"><a name="c-{{ cid }}" id="c-{{ cid }}"></a>
{{ label("Part " ~ cl.num ~ " of " ~ clusters|length, C.brand.cobalt) }}
<h2 style="margin:4px 0 0;{{ SANS }}font-size:24px;line-height:30px;font-weight:700;color:{{ C.brand.navy }};{{ LH }}">{{ cl.title }}</h2>
<p style="margin:4px 0 0;{{ SANS }}font-size:13px;line-height:19px;color:{{ C.text.secondary }};{{ LH }}">{{ cl.desc }} · <a href="#contents" style="color:{{ C.brand.cobalt }};text-decoration:underline;">Contents</a></p>
</td></tr>
{%- endmacro -%}
{%- macro has(cid) -%}{{ "1" if (clusters|selectattr("id", "equalto", cid)|list) else "" }}{%- endmacro -%}
{%- macro tiles(rows, cols=2) -%}
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0">
{% for row in rows|batch(cols) %}
<tr>
{% for t in row %}
<td class="stack" width="{{ (100 / cols)|int }}%" valign="top" style="width:{{ (100 / cols)|int }}%;padding:12px {{ 12 if not loop.last else 0 }}px 12px 0;border-top:1px solid {{ C.border.default }};">
{{ label(t.label, C.text.secondary) }}
<p style="margin:4px 0 0;{{ SANS }}font-size:21px;line-height:27px;font-weight:700;{% if t.get('color') %}color:{{ t.color }};{% else %}{{ PC }}{% endif %}white-space:nowrap;{{ LH }}">{{ t.value }}</p>
{% if t.get('change_pct') is not none %}<p style="margin:1px 0 0;{{ SANS }}font-size:13px;line-height:19px;font-weight:700;color:{{ t.change_pct|dircolor(t.get('neutral', False)) }};white-space:nowrap;{{ LH }}">{{ t.change_pct|arrow }}&nbsp;{{ t.change_pct|pct }}</p>{% elif t.get('chip') %}<p style="margin:1px 0 0;{{ SANS }}font-size:13px;line-height:19px;font-weight:700;color:{{ t.chip_color }};white-space:nowrap;{{ LH }}">{{ t.chip|nb }}</p>{% endif %}
{% if t.get('detail') %}<p style="margin:3px 0 0;{{ SANS }}font-size:13px;line-height:19px;color:{{ C.text.secondary }};{{ LH }}">{{ t.detail|t }}</p>{% endif %}
</td>
{% endfor %}
{% for _ in range(cols - row|length) %}<td class="stack" width="{{ (100 / cols)|int }}%" style="width:{{ (100 / cols)|int }}%;border-top:1px solid {{ C.border.default }};">&nbsp;</td>{% endfor %}
</tr>
{% endfor %}
</table>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml"{% if OL %} xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no,address=no,email=no,date=no">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>{{ pub.name }} · {{ date_short }}</title>
{% if OL %}<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:AllowPNG/><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><![endif]-->{% endif %}
<style>
a[x-apple-data-detectors]{color:inherit!important;text-decoration:none!important;}
@media screen and (max-width:600px){.gut{padding-left:20px!important;padding-right:20px!important;}.h1{font-size:23px!important;line-height:28px!important;}.stack{display:block!important;width:100%!important;padding-left:0!important;padding-right:0!important;}}
</style>
</head>
<body style="margin:0;padding:0;background-color:{{ C.surface.paper }};word-spacing:normal;{{ FONT }}">
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">{{ meta.preheader }}</div>
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
<tr><td align="left" style="padding:0;text-align:left;">
{% if OL %}<!--[if mso]><table role="presentation" width="{{ W }}" cellpadding="0" cellspacing="0" border="0" align="left"><tr><td><![endif]-->{% endif %}
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ C.surface.paper }}" style="width:100%;max-width:{{ W }}px;text-align:left;background-color:{{ C.surface.paper }};{{ FONT }}color:{{ C.text.primary }};">

{#- Masthead -#}
{% if OL %}{{ bandrow(C.brand.navy) }}{% endif %}
<tr><td class="gut" align="left" bgcolor="{{ T.mast_bg }}" style="text-align:left;padding:28px {{ G }}px 24px {{ G }}px;background-color:{{ T.mast_bg }};">
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
{% if logo_src %}<td width="48" valign="middle" style="width:48px;"><img src="{{ logo_src }}" width="48" height="48" alt="Kubeerra" style="display:block;width:48px;height:48px;border:0;outline:none;text-decoration:none;{{ SANS }}font-size:13px;font-weight:700;color:{{ T.mast_title }};"></td>{% elif logo_tile %}<td width="48" height="48" valign="middle" align="center" bgcolor="#0A0A0A" style="width:48px;height:48px;background-color:#0A0A0A;border:2px solid #C9A227;text-align:center;font-family:Georgia,'Times New Roman',serif;font-size:30px;line-height:44px;font-weight:700;color:#D4AF37;">K</td>{% endif %}
<td valign="middle" style="padding-left:{{ 16 if (logo_src or logo_tile) else 0 }}px;">
{{ label(edition_name, T.mast_soft) }}
<h1 class="h1" style="margin:2px 0 0;{{ SANS }}font-size:27px;line-height:32px;font-weight:700;color:{{ T.mast_title }};{{ LH }}">{{ pub.name }}</h1>
</td></tr></table>
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding-top:20px;">{{ rule(40, C.brand.cobalt) }}</td></tr></table>
{{ label(meta.weekday ~ " " ~ date_long ~ ((" · " ~ meta.label) if meta.audience == "internal" else ""), T.mast_soft, 12) }}
</td></tr>

{#- As-of strip -#}
<tr><td class="gut" align="left" bgcolor="{{ C.surface.soft }}" style="text-align:left;padding:12px {{ G }}px;background-color:{{ C.surface.soft }};">
<p style="margin:0;{{ MONO }}font-size:11px;line-height:16px;letter-spacing:0.8px;color:{{ C.text.secondary }};{{ LH }}">INDIA: {{ meta.india_as_of|upper }} · GLOBAL: {{ meta.global_as_of|upper }}</p>
{% if meta.audience == "internal" %}<p style="margin:4px 0 0;{{ MONO }}font-size:11px;line-height:16px;letter-spacing:0.8px;font-weight:700;color:{{ C.status.down }};{{ LH }}">INTERNAL · NOT FOR CLIENTS</p>{% endif %}
</td></tr>

{#- At a glance -#}
<tr><td class="gut"{% if OL %} align="left"{% endif %} style="{{ TL }}padding:28px {{ G }}px 0{{ GP }};">
<h2 style="margin:0;{{ SANS }}font-size:21px;line-height:27px;font-weight:700;{{ PC }}{{ LH }}">At a glance</h2>
{% if glance %}<div style="margin-top:12px;">{{ tiles(glance, 2) }}</div>{% endif %}
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:6px;">
{% for b in issue.brief %}
<tr><td width="16" valign="top" style="width:16px;padding-top:{{ 19 if loop.first else 13 }}px;">{% if OL %}<table{{ RP }} cellpadding="0" cellspacing="0" border="0"><tr><td width="6" height="6" bgcolor="{{ C.brand.cobalt }}" style="width:6px;height:6px;background-color:{{ C.brand.cobalt }};font-size:0;line-height:0;">&nbsp;</td></tr></table>{% else %}<div style="width:6px;height:6px;background-color:{{ C.brand.cobalt }};"></div>{% endif %}</td>
<td valign="top" style="padding-top:{{ 10 if loop.first else 4 }}px;{{ SANS }}font-size:16px;line-height:25px;{{ PC }}{{ LH }}">{{ b|t }}</td></tr>
{% endfor %}
</table>
{% if glance %}{{ para("Index closes for " ~ issue.snapshot.as_of|replace("close, ", "") ~ (("; gold and silver are IBJA " ~ metals.session ~ " rates for " ~ metals.date) if metals else "") ~ ". Sources are named in each section.", 12, 13, C.text.secondary) }}{% endif %}
</td></tr>

{#- In this issue -#}
<tr><td class="gut"{% if OL %} align="left"{% endif %} style="{{ TL }}padding:28px {{ G }}px 0{{ GP }};"><a name="contents" id="contents"></a>
{{ label("In this issue", C.brand.cobalt) }}
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin-top:6px;">
{% for cl in clusters %}
<tr><td width="28" valign="top" style="{% if OL %}width:28px;{% endif %}padding:9px 0;{{ B }}{{ MONO }}font-size:13px;line-height:21px;font-weight:700;color:{{ C.brand.cobalt }};{{ LH }}">{{ cl.num }}</td>
<td valign="top" style="padding:9px 0;{{ B }}{{ SANS }}font-size:15px;line-height:21px;{{ LH }}"><a href="#c-{{ cl.id }}" style="color:{{ C.text.primary }};font-weight:700;text-decoration:none;">{{ cl.title }}</a><br><span style="font-size:13px;{% if OL %}line-height:19px;{% endif %}color:{{ C.text.secondary }};">{{ cl.sections|map(attribute="title")|join(" · ") }}</span></td></tr>
{% endfor %}
<tr><td width="28" valign="top" style="width:28px;padding:9px 0;{{ MONO }}font-size:13px;line-height:21px;color:{{ C.text.secondary }};{{ LH }}">i</td>
<td valign="top" style="padding:9px 0;{{ SANS }}font-size:15px;line-height:21px;{{ LH }}"><a href="#disclosures" style="color:{{ C.text.primary }};font-weight:700;text-decoration:none;">Important disclosures</a></td></tr>
</table>
</td></tr>

{#- The week (closing and weekly editions, D-060) -#}
{% if has("week") %}{% set wk = issue.week %}
{{ band("week") }}
{{ sec("week", wk.get("headline")) }}
<tr><td class="gut"{% if OL %} align="left"{% endif %} style="{{ TL }}padding:14px {{ G }}px 0{{ GP }};">
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
{{ thr() }}{{ th("Market") }}{{ th(wk.get("from", "Start"), "right") }}{{ th(wk.get("to", "End"), "right") }}{{ th("Week", "right") }}</tr>
{% for w in week_rows %}<tr><td valign="top" style="padding:9px 8px 9px 0;{{ B }}{{ SANS }}font-size:15px;line-height:20px;font-weight:600;{{ PC }}{{ LH }}">{{ w.name }}{% if w.note %}<br><span style="font-size:12px;{% if OL %}line-height:16px;{% endif %}font-weight:400;color:{{ C.text.secondary }};">{{ w.note|t }}</span>{% endif %}</td><td align="right" valign="top" style="padding:9px 0 9px 8px;{{ B }}{{ SANS }}font-size:14px;line-height:20px;color:{{ C.text.secondary }};white-space:nowrap;{{ LH }}">{{ w.start_s }}</td><td align="right" valign="top" style="padding:9px 0 9px 8px;{{ B }}{{ SANS }}font-size:14px;line-height:20px;{{ PC }}white-space:nowrap;{{ LH }}">{{ w.end_s }}</td><td align="right" valign="top" style="padding:9px 0 9px 8px;{{ B }}{{ SANS }}font-size:14px;line-height:20px;font-weight:700;color:{{ w.color }};white-space:nowrap;{{ LH }}">{{ w.chg_s|nb }}</td></tr>{% endfor %}
</table>
{% for n in wk.get("notes", []) %}{{ item(n.get("title"), n.text, n|srcs) }}{% endfor %}
{{ srcline(wk["items"]|unique_sources, 10) }}
</td></tr>
{% endif %}

{#- 1 Markets -#}
{{ band("markets") }}
{{ sec("snapshot", issue.snapshot.headline) }}
<tr><td class="gut"{% if OL %} align="left"{% endif %} style="{{ TL }}padding:14px {{ G }}px 0{{ GP }};">
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
{{ thr() }}{{ th("Index") }}{{ th("Close", "right") }}{{ th("Change", "right") }}{{ th("%", "right") }}</tr>
{% for r in issue.snapshot.indices %}
{% set col = r.change|dircolor(r.neutral|default(false)) %}
<tr>
<td style="padding:9px 8px 9px 0;{{ B }}{{ SANS }}font-size:15px;line-height:20px;font-weight:600;{{ PC }}{{ LH }}">{{ r.name }}</td>
<td align="right" style="padding:9px 0 9px 8px;{{ B }}{{ SANS }}font-size:15px;line-height:20px;{{ PC }}white-space:nowrap;{{ LH }}">{{ r.close|level }}</td>
<td align="right" style="padding:9px 0 9px 8px;{{ B }}{{ SANS }}font-size:14px;line-height:20px;color:{{ col }};white-space:nowrap;{{ LH }}">{{ r.change|points }}</td>
<td align="right" style="padding:9px 0 9px 8px;{{ B }}{{ SANS }}font-size:14px;line-height:20px;font-weight:700;color:{{ col }};white-space:nowrap;{{ LH }}">{{ r.change_pct|arrow }}&nbsp;{{ r.change_pct|pct }}</td>
</tr>
{% endfor %}
</table>
{% if issue.snapshot.breadth %}{% set b = issue.snapshot.breadth %}{{ para("Breadth on the NSE: " ~ (b.advances|group) ~ " securities advanced and " ~ (b.declines|group) ~ " declined" ~ ((", " ~ (b.unchanged|group) ~ " unchanged") if b.get('unchanged') is not none else "") ~ ".", 12, 15, C.text.secondary) }}{% endif %}
{{ srcline(snapshot_sources, 6, "Data as of " ~ issue.snapshot.as_of ~ ". " ~ ("Sources" if snapshot_sources|length > 1 else "Source")) }}
</td></tr>

{% if "movers" in S %}{% set mv = issue.movers %}
{{ sec("movers", "The " ~ mv.universe ~ "'s largest gains and falls on the day") }}
<tr><td class="gut"{% if OL %} align="left"{% endif %} style="{{ TL }}padding:14px {{ G }}px 0{{ GP }};">
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
{% for title, rows in (("Gainers", mv.gainers), ("Losers", mv.losers)) %}
<td class="stack" width="50%" valign="top" style="width:50%;padding:0 {{ 12 if loop.first else 0 }}px 0 {{ 0 if loop.first else 12 }}px;">
{{ label(title, C.text.secondary) }}
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin-top:4px;">
{% for x in rows %}<tr><td valign="top" style="padding:8px 6px 8px 0;{{ B }}{{ SANS }}font-size:15px;line-height:20px;font-weight:600;{{ PC }}{{ LH }}">{{ x.name|t }}{% if x.get('close') %}<br><span style="font-size:12px;{% if OL %}line-height:17px;{% endif %}font-weight:400;color:{{ C.text.secondary }};">₹{{ x.close|level }}{% if x.get('note') %} · {{ x.note|t }}{% endif %}</span>{% elif x.get('note') %}<br><span style="font-size:12px;{% if OL %}line-height:17px;{% endif %}font-weight:400;color:{{ C.text.secondary }};">{{ x.note|t }}</span>{% endif %}</td><td align="right" valign="top" style="padding:8px 0;{{ B }}{{ SANS }}font-size:15px;line-height:20px;font-weight:700;color:{{ x.change_pct|dircolor }};white-space:nowrap;{{ LH }}">{{ x.change_pct|arrow }}&nbsp;{{ x.change_pct|pct }}</td></tr>{% endfor %}
</table>
</td>
{% endfor %}
</tr></table>
{{ srcline(mv|srcs, 10, mv.universe ~ " members, " ~ mv.as_of ~ ". Ranked by change on the day; not a recommendation. " ~ ("Sources" if (mv|srcs)|length > 1 else "Source")) }}
</td></tr>
{% endif %}

{% if "technicals" in S %}{% set tc = issue.technicals %}
