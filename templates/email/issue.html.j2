<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td bgcolor="{{ C.brand.paleBlue }}" style="padding:18px 20px;background-color:{{ C.brand.paleBlue }};border-left:4px solid {{ C.brand.cobalt }};">
<p style="margin:0;{{ SANS }}font-size:17px;line-height:24px;font-weight:700;color:{{ C.brand.navy }};{{ LH }}">{{ pub.talk.title }}</p>
<p style="margin:6px 0 0;{{ SANS }}font-size:15px;line-height:23px;{{ PC }}{{ LH }}">{{ pub.talk.text|t }}</p>
<p style="margin:10px 0 0;{{ SANS }}font-size:15px;line-height:23px;font-weight:600;{{ PC }}{{ LH }}">{% for k in pub.talk.links %}{{ klink(kb[k]) }}{% if not loop.last %} · {% endif %}{% endfor %}<br>Phone {{ pub.contacts.phone|t }} · <a href="mailto:{{ pub.contacts.email }}" style="color:{{ C.brand.cobalt }};text-decoration:underline;">{{ pub.contacts.email }}</a></p>
</td></tr></table>
</td></tr>
{{ sec("learn", issue.learn.id ~ ": " ~ issue.learn.title) }}
<tr><td class="gut"{% if OL %} align="left"{% endif %} style="{{ TL }}padding:4px {{ G }}px 0{{ GP }};">
{% for p in issue.learn.paragraphs %}{{ para(p, 8 if loop.first else 10, 16) }}{% endfor %}
{% if issue.learn.get('illustration') %}{{ para(issue.learn.illustration, 10, 13, C.text.secondary) }}{% endif %}
{% if issue.learn.get('link') %}<p style="margin:12px 0 0;{{ SANS }}font-size:15px;line-height:22px;font-weight:600;{{ PC }}{{ LH }}">Read more: {{ klink(issue.learn.link) }}</p>{% endif %}
{% if issue.learn.get('sources') %}{{ srcline(issue.learn.sources, 8) }}{% endif %}
</td></tr>

{#- 7 Calendar -#}
{{ band("calendar") }}
{{ sec("dayahead", issue.get("day_ahead_title") or ("On the calendar for " ~ meta.weekday ~ " " ~ date_short)) }}
<tr><td class="gut"{% if OL %} align="left"{% endif %} style="{{ TL }}padding:10px {{ G }}px 0{{ GP }};">
{% for d in issue.day_ahead %}{{ label(d.time, C.brand.cobalt, 6 if loop.first else 14) }}
<p style="margin:4px 0 0;{{ SANS }}font-size:15px;line-height:22px;{{ PC }}{{ LH }}">{{ d.event|t }}{% if d|srcs %} <span style="font-size:13px;{% if OL %}line-height:19px;{% endif %}color:{{ C.text.secondary }};">{{ names(d|srcs) }}</span>{% endif %}</p>
{% endfor %}
</td></tr>

{#- Important disclosures and footer -#}
<tr><td style="padding:44px 0 0 0;font-size:0;line-height:0;">&nbsp;</td></tr>
{% if OL %}{{ bandrow(C.brand.navy) }}{% endif %}
<tr><td class="gut" align="left" bgcolor="{{ T.foot_bg }}" style="{{ TL }}padding:32px {{ G }}px{% if OL %} 32px {{ G }}px{% endif %};background-color:{{ T.foot_bg }};{% if not OL %}color:{{ T.foot_soft }};font-size:13px;line-height:19px;{% endif %}"><a name="disclosures" id="disclosures"></a>
<p style="margin:0;{{ SANS }}font-size:18px;line-height:24px;font-weight:700;color:{{ T.foot_title }};{{ LH }}">Important disclosures</p>
<p style="margin:8px 0 0;{{ SANS }}font-size:14px;line-height:21px;font-weight:700;color:{{ T.foot_text }};{{ LH }}">{{ pub.publisher }} · {{ pub.registration.tagline }} · {{ pub.registration.arn }} · EUIN {{ pub.registration.euin }}</p>
{% for d in pub.disclosures %}<p style="margin:12px 0 0;{% if OL %}{{ SANS }}font-size:13px;line-height:19px;color:{{ T.foot_soft }};{{ LH }}{% endif %}"><b style="color:{{ T.foot_title }};">{{ d.title }}.</b> {{ d.paras|join(" ") }}</p>
{% endfor %}
<p style="margin:16px 0 0;{{ SANS }}font-size:14px;line-height:21px;font-weight:700;color:{{ T.foot_text }};{{ LH }}">{{ pub.standard_warning }}</p>
<table{{ RP }} width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding-top:20px;">{{ rule(40, C.brand.cobalt) }}</td></tr></table>
<p style="margin:16px 0 0;{{ SANS }}font-size:13px;line-height:20px;color:{{ T.foot_soft }};{{ LH }}">Phone {{ pub.contacts.phone|t }} · WhatsApp {{ pub.contacts.whatsapp|t }} · <a href="mailto:{{ pub.contacts.email }}" style="color:{{ T.foot_link }};text-decoration:underline;">{{ pub.contacts.email }}</a><br>{{ pub.contacts.hours }}<br>{{ pub.contacts.address }}</p>
<p style="margin:12px 0 0;{{ SANS }}font-size:13px;line-height:20px;color:{{ T.foot_soft }};{{ LH }}">{% for l in pub.links %}<a href="{{ l.url }}" style="color:{{ T.foot_link }};text-decoration:underline;">{{ l.label|nb }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
{% if meta.audience == "client" and pub.get('unsubscribe') %}<p style="margin:12px 0 0;{{ SANS }}font-size:13px;line-height:20px;color:{{ T.foot_soft }};{{ LH }}">{{ pub.unsubscribe }} <a href="mailto:{{ pub.contacts.email }}?subject=Unsubscribe" style="color:{{ T.foot_link }};text-decoration:underline;">{{ pub.contacts.email }}</a>.</p>{% endif %}
{% if meta.audience == "internal" %}<p style="margin:16px 0 0;{{ MONO }}font-size:11px;line-height:16px;letter-spacing:1px;color:{{ T.foot_soft }};{{ LH }}">{{ pub.pilot_note|upper }}</p>{% endif %}
</td></tr>
</table>
{% if OL %}<!--[if mso]></td></tr></table><![endif]-->{% endif %}
</td></tr>
</table>
</body>
</html>
