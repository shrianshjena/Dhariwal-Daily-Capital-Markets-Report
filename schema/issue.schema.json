{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubeerra.com/schema/market-brief-issue.json",
  "title": "Kubeerra Market Brief issue",
  "description": "One issue of the Kubeerra Market Brief. Every figure carries a source; the renderer turns this file into email HTML, plain text and an A4 PDF.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "brief",
    "snapshot",
    "flows",
    "sectors",
    "stories",
    "global",
    "ipos",
    "mf",
    "learn",
    "day_ahead",
    "sources"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "format": {
      "enum": [
        "crore_signed",
        "crore",
        "inr_level",
        "fx",
        "usd_bbl",
        "usd_oz",
        "pct_level",
        "lakh_crore",
        "count"
      ]
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value",
        "format",
        "detail",
        "source"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "value": {
          "type": "number"
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "detail": {
          "$ref": "#/$defs/text"
        },
        "provisional": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "also": {
          "$ref": "#/$defs/also"
        },
        "as_of": {
          "$ref": "#/$defs/text",
          "description": "Short time stamp when the figure is not as of the India close, e.g. 7:02 AM IST"
        },
        "change_pct": {
          "type": "number",
          "description": "Change against the stated comparison, in per cent; drives the green or red change line"
        },
        "direction": {
          "enum": [
            "up",
            "down",
            "flat"
          ],
          "description": "Explicit direction when no change_pct is given"
        },
        "flow": {
          "type": "boolean",
          "description": "True when the figure is itself a movement (a net flow): the figure is coloured by its sign. Signed crore figures are flows by default"
        },
        "change_bp": {
          "type": "number",
          "description": "Change in basis points, for yields; used when change_pct is absent"
        }
      }
    },
    "also": {
      "description": "Further pages an item draws on: one source, or a list of up to three",
      "oneOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      ]
    },
    "kubeerra_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "description": "A link readers can follow: only a kubeerra.com blog post or service page",
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "type": "string",
          "pattern": "^https://(www\\.)?kubeerra\\.com/"
        }
      }
    },
    "riskometer": {
      "enum": [
        "Low",
        "Low to Moderate",
        "Moderate",
        "Moderately High",
        "High",
        "Very High"
      ],
      "description": "SEBI riskometer level from the fund house's own factsheet, KIM, SID or disclosure"
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "weekday",
        "edition",
        "label",
        "audience",
        "india_as_of",
        "global_as_of",
        "preheader"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "weekday": {
          "$ref": "#/$defs/text"
        },
        "edition": {
          "$ref": "#/$defs/text"
        },
        "issue_number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "audience": {
          "enum": [
            "internal",
            "client"
          ]
        },
        "india_as_of": {
          "$ref": "#/$defs/text"
        },
        "global_as_of": {
          "$ref": "#/$defs/text"
        },
        "preheader": {
          "$ref": "#/$defs/text"
        },
        "subject": {
          "$ref": "#/$defs/text",
          "description": "Suggested email subject line"
        }
      }
    },
    "brief": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "as_of",
        "indices",
        "breadth"
      ],
      "properties": {
        "headline": {
          "$ref": "#/$defs/text"
        },
        "as_of": {
          "$ref": "#/$defs/text"
        },
        "indices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "close",
              "change",
              "change_pct",
              "source"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "close": {
                "type": "number"
              },
              "change": {
                "type": "number"
              },
              "change_pct": {
                "type": "number"
              },
              "neutral": {
                "type": "boolean",
                "description": "Colour neutrally, for measures such as India VIX where up is not good or bad"
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "breadth": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "advances",
            "declines",
            "source"
          ],
          "properties": {
            "advances": {
              "type": "integer"
            },
            "declines": {
              "type": "integer"
            },
            "unchanged": {
              "type": [
                "integer",
                "null"
              ]
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "flows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "tiles"
      ],
      "properties": {
        "headline": {
          "$ref": "#/$defs/text"
        },
        "tiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/figure"
          }
        }
      }
    },
    "sectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "as_of",
        "items",
        "source"
      ],
      "properties": {
        "headline": {
          "$ref": "#/$defs/text"
        },
        "as_of": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "change_pct"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/text"
              },
              "change_pct": {
                "type": "number"
              }
            }
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "stories": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "relevance",
          "headline",
          "what",
          "why",
          "source"
        ],
        "properties": {
          "topic": {
            "enum": [
              "Markets",
              "Flows",
              "Economy",
              "Global",
              "IPO",
              "Mutual funds",
              "Corporate",
              "Policy"
            ]
          },
          "relevance": {
            "enum": [
              "Market-wide",
              "Sector",
              "On the radar"
            ]
          },
          "headline": {
            "$ref": "#/$defs/text"
          },
          "what": {
            "$ref": "#/$defs/text"
          },
          "why": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "also": {
            "$ref": "#/$defs/also"
          }
        }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "items",
        "note"
      ],
      "properties": {
        "headline": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region",
              "name",
              "close",
              "change_pct",
              "as_of",
              "source"
            ],
            "properties": {
              "region": {
                "enum": [
                  "US",
                  "Europe",
                  "Asia",
                  "India offshore"
                ]
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "close": {
                "type": "number"
              },
              "change_pct": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "as_of": {
                "$ref": "#/$defs/text"
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "note_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "description": "Sources for facts in the note"
        }
      }
    },
    "ipos": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "items",
        "note"
      ],
      "properties": {
        "headline": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "company",
              "status",
              "facts",
              "source"
            ],
            "properties": {
              "company": {
                "$ref": "#/$defs/text"
              },
              "status": {
                "enum": [
                  "Open",
                  "Upcoming",
                  "Closed",
                  "Listed"
                ]
              },
              "facts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/text"
                }
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "also": {
                "$ref": "#/$defs/also"
              }
            }
          }
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "mf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "period",
        "stats",
        "highlights",
        "nfos",
        "regulatory"
      ],
      "properties": {
        "headline": {
          "$ref": "#/$defs/text"
        },
        "period": {
          "$ref": "#/$defs/text"
        },
        "stats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/figure"
          }
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "source"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "nfos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scheme",
              "category",
              "dates",
              "source"
            ],
            "properties": {
              "scheme": {
                "$ref": "#/$defs/text"
              },
              "category": {
                "$ref": "#/$defs/text"
              },
              "dates": {
                "$ref": "#/$defs/text"
              },
              "min_investment": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "riskometer": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/riskometer"
                  }
                ]
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "fund_house": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "regulatory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "body",
              "date",
              "text",
              "source"
            ],
            "properties": {
              "body": {
                "$ref": "#/$defs/text"
              },
              "date": {
                "$ref": "#/$defs/text"
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "nfo_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "source"
          ],
          "description": "Category-level summary of open NFOs, used only when no open NFO has a riskometer confirmed in the fund house's documents. Otherwise NFOs with a riskometer are named and the rest are counted, not named (D-042).",
          "properties": {
            "text": {
              "$ref": "#/$defs/text"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        },
        "inflow_leaders": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "period",
            "items",
            "source"
          ],
          "description": "Schemes with the largest net inflows in a month, as published by a reputable outlet. Facts only: category and riskometer for each, never returns.",
          "properties": {
            "period": {
              "$ref": "#/$defs/text",
              "description": "e.g. September 2026"
            },
            "basis": {
              "$ref": "#/$defs/text",
              "description": "What the outlet's figures cover, e.g. 'actively managed equity schemes, ACE MF data'"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scheme",
                  "category",
                  "net_inflow_cr",
                  "riskometer",
                  "riskometer_source"
                ],
                "properties": {
                  "scheme": {
                    "$ref": "#/$defs/text"
                  },
                  "category": {
                    "$ref": "#/$defs/text"
                  },
                  "net_inflow_cr": {
                    "type": "number"
                  },
                  "riskometer": {
                    "$ref": "#/$defs/riskometer"
                  },
                  "riskometer_source": {
                    "$ref": "#/$defs/source"
                  }
                }
              }
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "also": {
              "$ref": "#/$defs/also"
            }
          }
        },
        "etfs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "as_of",
            "items",
            "source"
          ],
          "description": "The most traded ETFs on NSE in the session, by turnover (exchange data)",
          "properties": {
            "as_of": {
              "$ref": "#/$defs/text",
              "description": "e.g. close, 2 Nov 2026"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "category",
                  "turnover_cr",
                  "riskometer",
                  "riskometer_source"
                ],
                "properties": {
                  "name": {
                    "$ref": "#/$defs/text"
                  },
                  "category": {
                    "$ref": "#/$defs/text"
                  },
                  "turnover_cr": {
                    "type": "number"
                  },
                  "change_pct": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "riskometer": {
                    "$ref": "#/$defs/riskometer"
                  },
                  "riskometer_source": {
                    "$ref": "#/$defs/source"
                  }
                }
              }
            },
            "note": {
              "$ref": "#/$defs/text"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "also": {
              "$ref": "#/$defs/also"
            }
          }
        },
        "fund_news": {
          "type": "array",
          "maxItems": 4,
          "description": "Facts about fund houses and schemes from the last seven days",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "who",
              "date",
              "text",
              "source"
            ],
            "properties": {
              "who": {
                "$ref": "#/$defs/text"
              },
              "date": {
                "$ref": "#/$defs/text"
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "riskometer": {
                "$ref": "#/$defs/riskometer"
              }
            }
          }
        },
        "link": {
          "$ref": "#/$defs/kubeerra_link",
          "description": "Optional 'Read more' link for the section"
        }
      }
    },
    "learn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "paragraphs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^L-\\d{3}$"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "illustration": {
          "type": [
            "string",
            "null"
          ]
        },
        "link": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/kubeerra_link"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "description": "Sources for figures quoted in the lesson"
        }
      }
    },
    "day_ahead": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time",
          "event"
        ],
        "properties": {
          "time": {
            "$ref": "#/$defs/text"
          },
          "event": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "also": {
            "$ref": "#/$defs/also"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "day_ahead_title": {
      "$ref": "#/$defs/text",
      "description": "Headline for the calendar section when it covers more than the edition day"
    }
  }
}
