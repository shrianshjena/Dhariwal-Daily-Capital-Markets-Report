{
  "_about": "Single source of design tokens for the Kubeerra Market Brief. Palette from the project-local newsletter design system (navy, cobalt, teal). Roles adjusted for WCAG contrast: text.muted (3.91:1 on white) and brand.teal (4.12:1) are not used for small text; text.secondary and brand.tealDark take those roles.",
  "color": {
    "brand": {
      "navy": "#0B1F33",
      "deepBlue": "#123B5D",
      "cobalt": "#2463D4",
      "teal": "#0F8B8D",
      "tealDark": "#08696D",
      "paleBlue": "#EAF2FC",
      "paleTeal": "#E7F5F3"
    },
    "surface": {
      "paper": "#FFFFFF",
      "canvas": "#F3F6FA",
      "soft": "#E8EEF4"
    },
    "text": {
      "primary": "#172B3A",
      "secondary": "#526779",
      "muted": "#718394",
      "inverse": "#FFFFFF",
      "inverseSoft": "#B9C7D6",
      "inverseLink": "#8FB4FF"
    },
    "border": {
      "default": "#D6E0E9",
      "inverse": "#25405C"
    },
    "status": {
      "up": "#13794A",
      "down": "#B42318"
    },
    "chart": {
      "gain": "#13794A",
      "loss": "#B42318",
      "track": "#EEF2F7"
    }
  },
  "font": {
    "email": {
      "sans": "'Helvetica Neue', Helvetica, Arial, sans-serif",
      "mono": "Consolas, Menlo, 'Courier New', monospace"
    },
    "pdf": {
      "sans": "'General Sans', 'Hanken Grotesk', 'DejaVu Sans', sans-serif",
      "mono": "'JetBrains Mono', 'DejaVu Sans Mono', monospace"
    }
  },
  "space": [
    0,
    4,
    8,
    12,
    16,
    24,
    32,
    40,
    48
  ],
  "layout": {
    "emailWidth": 640,
    "emailGutter": 32,
    "radius": 4
  },
  "contrast": {
    "text.primary on paper": "14.55:1",
    "text.secondary on paper": "5.87:1",
    "brand.cobalt on paper": "5.51:1",
    "brand.cobalt on paleBlue": "4.88:1",
    "brand.tealDark on paper": "6.46:1",
    "status.up on paper": "5.44:1",
    "status.down on paper": "6.57:1",
    "text.inverseSoft on navy": "9.70:1",
    "text.inverseLink on navy": "8.06:1",
    "chart.loss on paper (graphic)": "3.41:1"
  }
